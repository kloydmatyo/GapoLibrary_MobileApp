{
  "expo": {
    "name": "GapoLibrary",
    "slug": "gapolibrary-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./OCPL_LOGO.jpg",
    "scheme": "gapolibrary",
    "userInterfaceStyle": "light",
    "associatedDomains": [
      "applinks:your-gapolibrary-app.vercel.app"
    ],
    "splash": {
      "image": "./OCPL_LOGO.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gapolibrary.mobile"
    },
    "android": {
      "adaptiveIcon": {
          "foregroundImage": "./OCPL_LOGO.jpg",
          "backgroundColor": "#ffffff"
        },
      "package": "com.gapolibrary.mobile",
      "userInterfaceStyle": "light",
      "softwareKeyboardLayoutMode": "pan",
      "statusBar": {
        "hidden": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
